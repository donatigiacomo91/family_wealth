# Copia questo file in .env.local e inserisci i valori reali.
# .env.local non viene mai committato su git (vedi .gitignore).

# Queste due variabili servono solo quando collegheremo Supabase.
# Per ora l'app funziona con dati mock in memoria e non le richiede.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
